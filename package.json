{
  "name": "prpo-pdqc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"vite\"",
    "dev:frontend": "vite",
    "backend": "node server/server.js",
    "start": "concurrently \"npm run backend\" \"vite\"",
    "build": "vite build",
    "build:gas": "vite build --mode gas",
    "prepare:gas": "node scripts/prepare-gas.js",
    "gas:build": "npm run build:gas && npm run prepare:gas",
    "gas:status": "clasp status",
    "gas:push": "npm run gas:build && clasp push --force",
    "gas:deploy": "node scripts/deploy-gas.js",
    "test": "vitest run tests src/services/__tests__",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "lucide-react": "^1.31.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "cors": "^2.8.6",
    "esbuild": "^0.28.2",
    "express": "^4.22.2",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^7.1.1",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.2",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
