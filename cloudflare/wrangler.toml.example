# ====================================================================
# Cloudflare Pages + D1 Database Configuration Template
# ใช้เป็นตัวอย่างสำหรับให้ทีมงาน/เครื่องอื่น/ผู้พัฒนาอื่น Deploy
# ====================================================================

name = "prpo-pdqc"
pages_build_output_dir = "dist"
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]

# Cloudflare D1 SQL Database Binding
# 1. รันคำสั่งสร้างฐานข้อมูล: npx wrangler d1 create YOUR_DATABASE_NAME
# 2. นำ database_id ที่ได้มาใส่ในช่อง database_id ด้านล่าง
# 3. Apply migrations (ทดสอบ local): npx wrangler d1 migrations apply prpo-db --local
#    Production: npx wrangler d1 migrations apply prpo-db --remote (ผู้ใช้รันเองเท่านั้น)
[[d1_databases]]
binding = "DB"
database_name = "prpo-db"
database_id = "YOUR_CLOUDFLARE_D1_DATABASE_ID_HERE"
