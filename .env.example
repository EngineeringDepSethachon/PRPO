# URL ของ Google Apps Script Web App ที่ได้จากการกด Deploy ใน Google Apps Script
# เช่น https://script.google.com/macros/s/AKfycb.../exec
VITE_GAS_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# (ไม่บังคับ แต่แนะนำ) คีย์ความปลอดภัยที่ตรงกับ Script Properties "API_SECRET_KEY" บน Google Apps Script
VITE_API_SECRET_KEY=your_secure_random_key_here
